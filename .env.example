# Generate a fresh random value (e.g. python -c "import secrets; print(secrets.token_hex(32))")
ADAPTIVEAI_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADAPTIVEAI_DATABASE_URL=sqlite:///./data/adaptiveai.db
ADAPTIVEAI_STORAGE_DIR=./data
# Claude (Anthropic API) writes, checks and grades questions. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (best), claude-sonnet-5-5 (about half the cost), claude-haiku-5-5 (about 1/40 the cost)
ADAPTIVEAI_CHAT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max - higher effort spends more tokens per call
ADAPTIVEAI_EFFORT=low
# Local embedding model for PDF search (free, runs on this machine; ~130 MB download on first use)
ADAPTIVEAI_EMBED_MODEL=BAAI/bge-small-en-v1.5
ADAPTIVEAI_MAX_UPLOAD_MB=20
ADAPTIVEAI_MAX_DOCUMENTS=8
ADAPTIVEAI_MAX_PAGES=300
ADAPTIVEAI_MAX_QUESTIONS=40
ADAPTIVEAI_CHUNK_CHARS=1200
ADAPTIVEAI_CHUNK_OVERLAP=180
ADAPTIVEAI_RETRIEVAL_TOP_K=6
ADAPTIVEAI_ADAPT_MIN_ANSWERS=3
ADAPTIVEAI_ADAPT_HIGH=0.85
ADAPTIVEAI_ADAPT_LOW=0.40
